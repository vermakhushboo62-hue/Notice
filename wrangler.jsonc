// Cloudflare Workers config: serve the Vite build in dist/ as static assets.
// Having this file stops `wrangler deploy` from trying to auto-configure the project.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notice",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
